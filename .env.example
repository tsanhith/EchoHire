# Copy this file to .env and fill in your own keys. Never commit .env.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile   # try llama-3.1-8b-instant for a bigger daily quota
# GOOGLE_API_KEY=                      # aistudio.google.com — enables Gemini fallback when Groq rate-limits
# GEMINI_MODEL=gemini-2.5-flash
