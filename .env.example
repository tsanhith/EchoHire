# Copy this file to .env and fill in your own keys. Never commit .env.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Optional LLM fallback chain (Groq -> Cerebras -> Gemini -> OpenRouter).
# Any provider with a key set is added automatically.
# CEREBRAS_API_KEY=                    # cloud.cerebras.ai — ~1M free tokens/day
# GOOGLE_API_KEY=                      # aistudio.google.com — Gemini free tier
# OPENROUTER_API_KEY=                  # openrouter.ai — many models, low free limits
# Recruiter dashboard protection: if set, /api/results and /api/candidates
# require ?key=<this value> (open results.html?key=... in the browser)
# RECRUITER_KEY=

# Model overrides
# GROQ_MODEL=llama-3.3-70b-versatile   # try llama-3.1-8b-instant for a bigger daily quota
# CEREBRAS_MODEL=gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
